/* Dibuja los numeros con segmentos. */
void DibujarDigito(int numero, int x, int y)
{
    uint8_t s = segmentos[numero];

    if (s & 0x01)
    	FillRect(x + 3, y, 14, 3, morado);

    if (s & 0x02)
        FillRect(x + 17, y + 3, 3, 13, morado);

    if (s & 0x04)
        FillRect(x + 17, y + 19, 3, 13, morado);

    if (s & 0x08)
        FillRect(x + 3, y + 32, 14, 3, morado);

    if (s & 0x10)
        FillRect(x, y + 19, 3, 13, morado);

    if (s & 0x20)
        FillRect(x, y + 3, 3, 13, morado);

    if (s & 0x40)
        FillRect(x + 3, y + 16, 14, 3, morado);
}

//Para dibujar con cubitos las posiciones de los brazos//
void DibujarBrazo(int x, int y, int largo, int posicion)
{
    /* Parte superior del brazo. */
    FillRect(x - 2, y - largo, 5, largo, morado);

    if (posicion == 0)
    {
        /* Antebrazo extendido hacia abajo. */
        FillRect(x - 2, y, 5, largo, morado);

        /* Mano. */
        FillRect(x - 3, y + largo - 2, 7, 6, rosa);
    }

    if (posicion == 1)
    {
        /* Antebrazo horizontal. */
        FillRect(x, y - 2, largo, 5, morado);

        /* Mano. */
        FillRect(x + largo - 2, y - 3, 6, 7, rosa);
    }

    if (posicion == 2)
    {
        /* Antebrazo diagonal hacia arriba. */
        int diagonal = largo * 7 / 10;
        for (int i = 0; i <= diagonal; i++)
        {
            FillRect(x + i - 2, y - i - 2, 5, 5, morado);
        }

        /* Mano. */
        FillRect(x + diagonal - 3, y - diagonal - 3, 7, 7, rosa);
    }

    /* Codo. */
    FillRect(x - 3, y - 3, 7, 7, rosa);
}


/* Muestra la ultima medicion valida. */
void DibujarDato(void)
{
    FillRect(8, 48, 139, 112, panel);
    LCD_Print("ANGULO", 16, 56, 1, gris, panel);
    LCD_Print("RELATIVO", 16, 72, 1, gris, panel);

    if (hayDato == 1)
    {
        int centenas = angulo / 100;
        int decenas = (angulo / 10) % 10;
        int unidades = angulo % 10;

        if (centenas > 0)
        {
            DibujarDigito(centenas, 18, 94);
        }

        if (centenas > 0 || decenas > 0)
        {
            DibujarDigito(decenas, 45, 94);
        }

        DibujarDigito(unidades, 72, 94);

        LCD_Print("deg",104, 108, 1, texto, panel);

        LCD_Print("ULTIMA VALIDA",16, 140, 1, morado, panel);
    }
    else
    {
        LCD_Print("--", 20, 101, 2, morado, panel);

        LCD_Print("deg", 104, 108, 1, texto, panel);

        LCD_Print("SIN LECTURA", 16, 140, 1, gris, panel);
    }
}


/* Muestra el paso actual de la guia. */
void DibujarGuia(void)
{
    FillRect(154, 48, 158, 112, panel);
    LCD_Print("GUIA DEL BRAZO", 164, 56, 1, gris, panel);

    if (paso == 0)
    {
        DibujarImagen(185, 68, brazoExtendido);
    }

    if (paso == 1)
    {
        DibujarImagen(185, 68, brazoIntermedio);
    }

    if (paso == 2)
    {
        DibujarImagen(185, 68, brazoFlexionado);
    }

    if (paso == 0)
    {
        LCD_Print("EXTENDIDO", 164, 145, 1, morado, panel);
    }

    if (paso == 1)
    {
        LCD_Print("INTERMEDIO", 164, 145, 1, morado, panel);
    }

    if (paso == 2)
    {
        LCD_Print("FLEXIONADO", 164, 145, 1, morado, panel);
    }

    /* Tarjetas de las tres posiciones. */
    for (int i = 0; i < 3; i++)
    {
        int x = 8 + i * 103;
        uint16_t borde = lavanda;

        if (i == paso)
        {
            borde = morado;
        }

        FillRect(x, 183, 98, 49, borde);
        FillRect(x + 2, 185, 94, 45, panel);

        if (i == 0)
        {
            LCD_Print("1 RECTO", x + 5, 188, 1, texto, panel);
        }

        if (i == 1)
        {
            LCD_Print("2 MEDIO", x + 5, 188, 1, texto, panel);
        }

        if (i == 2)
        {
            LCD_Print("3 DOBLADO", x + 5, 188, 1, texto, panel);
        }

        DibujarBrazo(x + 36, 215, 10, i);

        if (i == paso)
        {
            FillRect(x + 6, 227, 86, 2, morado);
        }
    }
}


/* Dibuja el fondo y el encabezado una sola vez. */
void IniciarPantalla(void)
{
    paso = 0;
    hayDato = 0;
    actualizarDato = 0;
    tiempoAnterior = HAL_GetTick();

    LCD_Clear(fondo);

    FillRect(0, 0, 320, 39, panel);
    FillRect(0, 39, 320, 2, morado);

    LCD_Print("REHABILITACION CODO", 12, 5, 2, morado, panel);
    LCD_Print("Flexion y extension", 12, 25, 1, gris, panel);
    LCD_Print("SIGUE LA SECUENCIA: 1 -> 2 -> 3", 8, 166, 1, texto, fondo);

    DibujarDato();
    DibujarGuia();
}


/* ACTUALIZA LOS DATOS y cambia el dibujo cada 1.5 segundos. */
void ActualizarPantalla(void)
{
    uint32_t ahora = HAL_GetTick();

    if (actualizarDato == 1)
    {
        DibujarDato();
        actualizarDato = 0;
    }

    if (ahora - tiempoAnterior >= 1500U)
    {
        tiempoAnterior = ahora;

        paso++;

        if (paso > 2)
        {
            paso = 0;
        }

        DibujarGuia();
    }
}

void NuevaMedicion(int nuevoAngulo)
{
    if (nuevoAngulo >= 0 && nuevoAngulo <= 180)
    {
        angulo = nuevoAngulo;
        hayDato = 1;
        actualizarDato = 1;
    }
}

void DibujarImagen(int x, int y, const uint16_t imagen[])
{
    for (int fila = 0; fila < 76; fila++)
    {
        for (int columna = 0; columna < 96; columna++)
        {
            uint16_t color = imagen[fila * 96 + columna];

            /* Omite los pixeles blancos o casi blancos. */
            if ((color & 0xF800) < 0xE000 || (color & 0x07E0) < 0x0700 || (color & 0x001F) < 0x001C)
            {
                FillRect(x + columna, y + fila, 1, 1, color);
            }
        }
    }
}

