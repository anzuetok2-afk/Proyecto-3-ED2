/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_FATFS_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();
  MX_USART3_UART_Init();
  /* USER CODE BEGIN 2 */
  LCD_Init();
  IniciarPantalla();


  /* Prueba de comunicacion con el MPU6050. */
  uint8_t identificador = 0;
  HAL_StatusTypeDef estadoSensor;
  char mensajeSensor[70];

  HAL_Delay(100);

  /* Indicar que queremos leer el registro del identificador. */
  uint8_t registro = 0x75;

  estadoSensor = HAL_I2C_Master_Transmit(&hi2c1, 0xD0, &registro, 1, 100);

  if (estadoSensor == HAL_OK)
  {
      estadoSensor = HAL_I2C_Master_Receive(&hi2c1, 0xD0, &identificador, 1, 100);
  }

  /* Revisar el resultado de la comunicacion. */
  if (estadoSensor == HAL_OK)
  {
      sprintf(mensajeSensor, "Identificador del sensor: 0x%02X\r\n", (unsigned int)identificador);

      transmit_uart(mensajeSensor);

      if (identificador == 0x70)
      {
          transmit_uart("Identificador compatible con MPU6500.\r\n");

          /*
           * Cada fila contiene registro que queremos configurar, valor
           */
          uint8_t configuracion[4][2] = {
              {0x6B, 0x01}, /* Despertar el sensor */
              {0x6C, 0x00}, /* Habilitar todos los ejes */
              {0x1B, 0x00}, /* Giroscopio: +/-250 grados/s */
              {0x1C, 0x00}  /* Acelerometro: +/-2 g */
          };

          for (int i = 0; i < 4; i++)
          {
              estadoSensor = HAL_I2C_Master_Transmit(&hi2c1, 0xD0, configuracion[i], 2, 100);

              if (estadoSensor != HAL_OK)
              {
                  break;
              }
          }

          HAL_Delay(100);

          if (estadoSensor == HAL_OK)
          {
        	  sensorListo = 1;
              transmit_uart("Configuracion enviada correctamente.\r\n");
          }
          else
          {
        	  sensorListo = 0;
              transmit_uart("Error al configurar el sensor.\r\n");
          }
      }

      else
      {
          transmit_uart("El sensor responde con otro identificador.\r\n");
      }
  }
  else
  {
      transmit_uart("No se pudo leer el sensor. Revisar conexiones.\r\n");

  }


  /* Comprobar la tarjeta al arrancar. */
  fres = f_mount(&fs, "/", 1);

  if (fres == FR_OK)
  {
      transmit_uart("MicroSD lista.\r\n");
  }
  else
  {
      transmit_uart("MicroSD no disponible.\r\n");
  }

  HAL_UART_Receive_IT(&huart3, &datoRecibido, 1);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      /* USER CODE END WHILE */

      /* USER CODE BEGIN 3 */

      if (comandoPendiente != 0)
      {
          uint8_t comando;

          HAL_NVIC_DisableIRQ(USART3_IRQn);

          comando = comandoPendiente;
          comandoPendiente = 0;

          HAL_NVIC_EnableIRQ(USART3_IRQn);
          ProcesarComando(comando);
      }

      AtenderSensor();
      ActualizarPantalla();
  }

  /* USER CODE END 3 */
}

