void GuardarMedicion(void)
{
    if (adquisicionActiva == 1)
    {
        EnviarRespuesta("ERROR,OCUPADO\r\n");
        return;
    }

    if (hayDato == 0)
    {
        EnviarRespuesta("ERROR,SIN_MEDICION\r\n");
        return;
    }

    fres = f_mount(&fs, "/", 1);

    if (fres != FR_OK)
    {
        EnviarRespuesta("ERROR,SD_MONTAJE\r\n");
        return;
    }

    fres = f_open(&fil, "Angulos.txt", FA_OPEN_APPEND | FA_WRITE);

    if (fres != FR_OK)
    {
        EnviarRespuesta("ERROR,SD_ABRIR\r\n");
        return;
    }

    char registro[40];

    sprintf(registro, "%d grados\r\n", angulo);

    int escrito = f_puts(registro, &fil);

    fres = f_close(&fil);

    if (escrito >= 0 && fres == FR_OK)
    {
        EnviarRespuesta("GUARDADO,OK\r\n");
    }
    else
    {
        EnviarRespuesta("ERROR,SD_ESCRIBIR\r\n");
    }
}

/* Atiende los comandos recibidos. */
void ProcesarComando(uint8_t comando)
{
    if (comando == 'M')
    {

        if (sensorListo == 0)
        {
            EnviarRespuesta("ERROR,SENSOR\r\n");
        }
        else if (adquisicionActiva == 1)
        {
            EnviarRespuesta("ERROR,OCUPADO\r\n");
        }
        else
        {
            sumaX = 0;
            sumaY = 0;
            sumaZ = 0;
            cantidadMuestras = 0;

            inicioAdquisicion = HAL_GetTick();
            tiempoSensor = inicioAdquisicion;

            adquisicionActiva = 1;
        }
    }
    else if (comando == 'G')
    {
        GuardarMedicion();
    }
}


/* Obtiene un promedio de 20 lecturas por solicitud. */
void AtenderSensor(void)
{
    if (adquisicionActiva == 0)
    {
        return;
    }

    if (HAL_GetTick() - inicioAdquisicion >= 5000U)
    {
        adquisicionActiva = 0;

        EnviarRespuesta("ERROR,TIEMPO\r\n");
        return;
    }

    if (HAL_GetTick() - tiempoSensor < 25U)
    {
        return;
    }

    tiempoSensor = HAL_GetTick();

    uint8_t registroDatos = 0x3B;
    uint8_t datos[6];

    HAL_StatusTypeDef resultado;

    resultado = HAL_I2C_Master_Transmit(&hi2c1, 0xD0, &registroDatos, 1, 100);

    if (resultado == HAL_OK)
    {
        resultado = HAL_I2C_Master_Receive(&hi2c1, 0xD0, datos, 6, 100);
    }

    if (resultado != HAL_OK)
    {
        adquisicionActiva = 0;
        EnviarRespuesta("ERROR,LECTURA\r\n");
        return;
    }

    int ax = datos[0] * 256 + datos[1];
    int ay = datos[2] * 256 + datos[3];
    int az = datos[4] * 256 + datos[5];

    if (ax > 32767) ax = ax - 65536;
    if (ay > 32767) ay = ay - 65536;
    if (az > 32767) az = az - 65536;

    sumaX = sumaX + ax;
    sumaY = sumaY + ay;
    sumaZ = sumaZ + az;

    cantidadMuestras++;

    if (cantidadMuestras < 20)
    {
        return;
    }

    int promedioX = sumaX / 20;
    int promedioY = sumaY / 20;
    int promedioZ = sumaZ / 20;

    sumaX = 0;
    sumaY = 0;
    sumaZ = 0;

    cantidadMuestras = 0;
    adquisicionActiva = 0;

    /* La primera medicion establece la referencia. */
    if (referenciaLista == 0)
    {
        referenciaX = promedioX;
        referenciaY = promedioY;
        referenciaZ = promedioZ;
    }

    int nuevoAngulo = CalcularAngulo(promedioX, promedioY, promedioZ);

    if (nuevoAngulo < 0)
    {
        EnviarRespuesta("ERROR,MEDICION\r\n");
        return;
    }

    referenciaLista = 1;

    NuevaMedicion(nuevoAngulo);
    ActualizarPantalla();

    char mensaje[50];
    sprintf(mensaje, "ANGULO,%d,deg\r\n", angulo);
    EnviarRespuesta(mensaje);
}


void EnviarRespuesta(char *mensaje)
{
    HAL_UART_Transmit(&huart3, (uint8_t *)mensaje, strlen(mensaje), 1000);
    transmit_uart(mensaje);
}
