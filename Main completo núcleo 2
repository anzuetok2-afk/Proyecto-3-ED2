{
    HAL_UART_Transmit(&huart2,
                      (uint8_t *)mensaje,
                      strlen(mensaje),
                      1000);
}

int CalcularAngulo(int ax, int ay, int az)
{
    /* Reducir los valores para trabajar con numeros pequeños. */
    int x = ax / 128;
    int y = ay / 128;
    int z = az / 128;

    int rx = referenciaX / 128;
    int ry = referenciaY / 128;
    int rz = referenciaZ / 128;

    int64_t tamanoActual = x * x + y * y + z * z;
    int64_t tamanoReferencia = rx * rx + ry * ry + rz * rz;

    if (tamanoActual == 0 || tamanoReferencia == 0)
    {
        return -1;
    }

    /* Comparar la direccion actual con la inicial. */
    int64_t producto =
        (int64_t)x * rx +
        (int64_t)y * ry +
        (int64_t)z * rz;

    int64_t comparacion = producto * producto * 10000;
    int64_t tamanos = tamanoActual * tamanoReferencia;

    const int limites[18] = {9981, 9830, 9532, 9096, 8536, 7868, 7113, 6294, 5436, 4564, 3706, 2887, 2132, 1464, 904, 468, 170, 19};

    int resultado = 90;
    for (int i = 0; i < 18; i++)
    {
        if (comparacion >= tamanos * limites[i])
        {
            resultado = i * 5;
            break;
        }
    }

    /* Distinguir inclinaciones mayores de 90 grados. */
    if (producto < 0)
    {
        resultado = 180 - resultado;
    }

    return resultado;
}


